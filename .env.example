# Copy to .env and fill in from Supabase → Settings → API.
# Only the anon (publishable) key belongs here — it ships in the app bundle and
# is protected by Row Level Security. Never put the service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where invite links point. Falls back to the running origin on web, so this
# only needs setting if links must point somewhere other than where the app is
# served from. Emails use the edge function's own SITE_URL secret, not this.
EXPO_PUBLIC_SITE_URL=https://blurryinvitational.com

# Web Push. Generate a pair with `npx web-push generate-vapid-keys`.
# Only the PUBLIC half goes here — the private key is a signing key and lives in
# the send-push edge function's secrets. See docs/push.md.
# Leave blank to ship without push; the UI hides itself when it's unset.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
