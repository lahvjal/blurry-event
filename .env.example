# Copy to .env and fill in from Supabase → Settings → API.
# Only the anon (publishable) key belongs here — it ships in the app bundle and
# is protected by Row Level Security. Never put the service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
